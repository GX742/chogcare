[Unit]
Description=ChogCare payment processing
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=chogcare
Group=chogcare
StateDirectory=chogcare
StateDirectoryMode=0700
WorkingDirectory=/var/lib/chogcare
ExecStart=/usr/bin/node /opt/chogcare-payments/scripts/cloud-payments.mjs
LoadCredentialEncrypted=custody-password:/etc/credstore.encrypted/chogcare-custody
Environment=CHOGCARE_PUBLIC_ORIGIN=https://chogcare.xyz
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chogcare
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
MemoryHigh=650M
MemoryMax=900M
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
