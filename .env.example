# Legacy wallet-route settings. Current checkout uses no injected wallet.
# Never put custody private keys or seeds into VITE_* variables.
VITE_SOURCE_ROUTER_ADDRESS=
VITE_CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777
VITE_MONAD_RPC_URL=https://rpc.monad.xyz
# Public values only. Never put an OBS/Owncast stream key in a VITE_* variable.
VITE_PUBLIC_SITE_URL=https://chogcare.xyz/
# The public relay is validated and reached through the deployed same-origin proxy.
VITE_OWNCAST_URL=https://chogcare-stream.tail1f833b.ts.net
# Optional, explicitly configured fallback. No personal channel is selected by default.
VITE_TWITCH_CHANNEL=
