{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/live/:path*",
      "destination": "https://45.38.60.159/live/:path*"
    },
    {
      "source": "/hls/:path*",
      "destination": "https://45.38.60.159/hls/:path*"
    },
    {
      "source": "/api/payments/:path*",
      "destination": "https://45.38.60.159/api/payments/:path*"
    },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/live/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/hls/((?!mobile/stream-[0-9]+\\.ts$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/hls/(mobile/stream-[0-9]+\\.ts)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src https://player.twitch.tv https://stream.chogcare.com; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' data: https://giveth.mypinata.cloud https://gateway.pinata.cloud https://www.animal-ethics.org https://media-refresh.heifer.org; font-src 'self'; connect-src 'self' https://45.38.60.159; form-action 'none'; worker-src 'self' blob:; media-src 'self' blob: https://45.38.60.159; manifest-src 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
