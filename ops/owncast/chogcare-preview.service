[Unit]
Description=ChogCare fresh broadcast preview
After=chogcare-mobile.service
Wants=chogcare-mobile.service

[Service]
Type=simple
User=owncast
Group=owncast
StateDirectory=chogcare-preview
StateDirectoryMode=0755
WorkingDirectory=/var/lib/chogcare-preview
# One small, atomically replaced frame per second from the existing local HLS.
ExecStart=/opt/owncast/ffmpeg -hide_banner -loglevel warning -nostdin -live_start_index -1 -i /var/lib/chogcare-mobile/stream.m3u8 -an -vf fps=1,scale=360:640 -c:v mjpeg -q:v 5 -f image2 -update 1 -atomic_writing 1 /var/lib/chogcare-preview/preview.jpg
ExecStopPost=/usr/bin/rm -f /var/lib/chogcare-preview/preview.jpg
Restart=always
RestartSec=2
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M
TasksMax=96

[Install]
WantedBy=multi-user.target
